h1 = @piece['name']

/- Optional icon preview and icon base color metadata.
- if @piece['image_path'] && !@piece['image_path'].empty?
  p
    img src=@piece['image_path'] alt="#{@piece['name']} icon" style="width: 5rem; height: 5rem; object-fit: fill; border: 1px solid #bbb;"
  p
    strong Icon base color:
    |  #{@piece['icon_base_color'] || 'black'}

p
  strong ID:
  |  #{@piece['id']}

/- Optional piece description.
- if @piece['description'] && !@piece['description'].empty?
  p
    strong Description:
    |  #{@piece['description']}

/- Edit/delete controls.
p
  a href="/pieces/#{@piece['id']}/edit" Edit piece

p
  form action="/pieces/#{@piece['id']}/delete" method="post"
    button type="submit" Delete piece

h2 Special Attributes

/- Lists powers currently attached to the piece.
- if @special_powers.empty?
  p No special attributes enabled.
- else
  ul
    - @special_powers.each do |power|
      li
        strong = power['name']
        - if power['description'] && !power['description'].empty?
          |  - #{power['description']}

h2 Movement Rules

/- Lists configured movement rows and effective options.
- if @piece_moves.empty?
  p No movement rules linked.
- else
  ul
    - @piece_moves.each do |move|
      li
        strong = move['name']
        |  (#{move['kind']})
        |  - mode: #{move['mode']}
        |  - color: #{move['color_scope']}
        - if move['ray_limit']
          |  - ray limit: #{move['ray_limit']}
        - else
          |  - ray limit: infinite
        - if move['first_move_only'].to_i == 1
          |  - first move only
        - if move['method_description'] && !move['method_description'].empty?
          |  - #{move['method_description']}

/- Static move preview for persisted piece configuration.
== slim :_piece_preview, locals: { preview_title: 'Move Preview Sandbox', preview_source: 'static', preview_piece_name: @piece['name'], preview_piece_icon: @piece['image_path'], preview_piece_icon_base_color: (@piece['icon_base_color'] || 'black'), preview_moves: @preview_piece_moves, preview_initial_size: 8 }

/- Back navigation.
p
  a href="/pieces" Back to pieces
